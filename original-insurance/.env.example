# Production settings; configure in the Vercel project before deploying.
INTAKE_ORIGIN=https://originalinsurance.net
# Generate a random salt and scrypt(password, salt, 64), encoded as salt:hex-hash.
INTAKE_ADMIN_PASSWORD_HASH=
# At least 32 random characters. Rotating this logs out every admin session.
INTAKE_SESSION_SECRET=
# A small Redis store holds ONE settings document and expiring rate counters.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
RESEND_API_KEY=
# Must be a verified sending domain in Resend.
INTAKE_EMAIL_FROM=Original Insurance <quotes@originalinsurance.net>
INTAKE_EMAIL_TO=contact@originalinsurance.net
# Local testing ONLY; forcibly ignored on Vercel and in production.
INTAKE_LOCAL_MODE=false
