---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import type { Carrier } from '../data/carriers';
interface Props {
  carrier: Carrier;
}
const { carrier } = Astro.props;
const assets = import.meta.glob<{ default: ImageMetadata }>('../assets/carriers/*.png', {
  eager: true,
});
const source = carrier.logo ? assets[`../assets/carriers/${carrier.logo}`]?.default : undefined;
---

<span
  class="carrier-logo"
  data-logo-shape={
    source
      ? source.width / source.height > 6
        ? 'wide'
        : source.width / source.height < 2.5
          ? 'compact'
          : 'standard'
      : 'text'
  }
>
  {source ? (
    <Image
      src={source}
      alt={carrier.name}
      width={Math.min(source.width / source.height > 6 ? 175 : 145, source.width)}
      densities={[1, 2]}
      format="webp"
      loading="lazy"
      decoding="async"
    />
  ) : (
    <span>{carrier.name}</span>
  )}
</span>
