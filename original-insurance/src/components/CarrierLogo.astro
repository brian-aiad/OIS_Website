---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import type { Carrier } from '../data/carriers';
interface Props {
  carrier: Carrier;
}
const { carrier } = Astro.props;
const assets = import.meta.glob<{ default: ImageMetadata }>('../assets/carriers/*.png', {
  eager: true,
});
const source = carrier.logo ? assets[`../assets/carriers/${carrier.logo}`]?.default : undefined;
---

<span class="carrier-logo">
  {source ? (
    <Image
      src={source}
      alt={carrier.name}
      width={Math.min(145, source.width)}
      densities={[1, 2]}
      format="webp"
      loading="lazy"
      decoding="async"
    />
  ) : (
    <span>{carrier.name}</span>
  )}
</span>
