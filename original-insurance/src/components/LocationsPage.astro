---
import PageHero from './PageHero.astro';
import AreaLinks from './AreaLinks.astro';
import Icon from './Icon.astro';
import { contact } from '../data/site';
import '../styles/locations.css';
---

<PageHero
  label="Our Downey office"
  title="Visit our Downey office."
  text="Walk-ins are welcome at our Paramount Boulevard office. Bring your questions, your current policy, or simply an idea of what you need."
  image="ois-storefront-real.jpg"
  alt="The Original Insurance Services office on Paramount Boulevard"
  quote={false}
/>
<section class="section locations-visit" aria-label="Plan your visit">
  <div class="container visit-layout">
    <div class="locations-map-column">
      <p class="eyebrow">One local office. A personal welcome.</p>
      <h2>Address & directions</h2>
      <address class="visit-address">
        9907-B Paramount Blvd
        <br />
        Downey, CA 90240
      </address>
      <div class="actions">
        <a href={contact.maps} target="_blank" rel="noreferrer" class="button button-ink">
          Get directions <Icon name="diagonal" />
        </a>
        <button class="text-link" data-copy-address={contact.address}>
          Copy address
        </button>
      </div>
      <p id="copy-status" role="status" class="form-note"></p>
      <div class="office-map">
        <div class="locations-map-fallback" aria-hidden="true">
          <Icon name="pin" size={35} />
          <span>Original Insurance Services</span>
          <small>9907-B Paramount Blvd · Downey</small>
        </div>
        <iframe
          title="Map showing the Original Insurance office in Downey"
          src="https://www.google.com/maps?q=9907B+Paramount+Blvd+Downey+CA+90240&output=embed"
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
        ></iframe>
      </div>
      <p class="locations-map-caption">
        <Icon name="pin" size={17} /> Original Insurance Services · Downey, California
      </p>
      <a class="locations-map-external" href={contact.maps} target="_blank" rel="noreferrer">
        Open the map in Google Maps <Icon name="diagonal" size={15} />
      </a>
      <div class="locations-prepare">
        <Icon name="file" size={25} />
        <div>
          <h3>A useful place to start.</h3>
          <p>
            Bring your questions and your current policy if you have one. Coming in for a specific
            service? Call first and we can explain what to bring.
          </p>
        </div>
      </div>
    </div>
    <div class="locations-info">
      <div class="visit-details locations-hours">
        <p class="eyebrow">When to stop by</p>
        <h3>Office hours</h3>
        <p>All times Pacific. Holiday hours may vary; call before a holiday visit.</p>
        <dl class="hours-list">
          {['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday', 'Sunday'].map(
            (day, i) => (
              <div>
                <dt>{day}</dt>
                <dd>{i < 5 ? '10:00 AM–5:30 PM' : 'Closed'}</dd>
              </div>
            ),
          )}
        </dl>
        <a class="text-link" href={contact.phoneHref}>
          Call {contact.phone} <Icon name="phone" size={17} />
        </a>
      </div>
      <div class="visit-details locations-practical">
        <Icon name="pin" size={24} />
        <div>
          <h3>Parking & access</h3>
          <p>
            Free on-site parking and street parking on Paramount Boulevard. The office has a
            wheelchair-accessible entrance, parking, and seating.
          </p>
          <p>Need help planning your visit? Call us so we can assist.</p>
        </div>
      </div>
      <div class="visit-details locations-practical">
        <Icon name="phone" size={24} />
        <div>
          <h3>In your language</h3>
          <p>
            English, Spanish, and Arabic. You can also work with us by phone, text, or email if you
            prefer not to visit.
          </p>
          <a href="/contact" class="text-link">
            Find your way to reach us <Icon size={17} />
          </a>
        </div>
      </div>
    </div>
  </div>
</section>
<AreaLinks />
