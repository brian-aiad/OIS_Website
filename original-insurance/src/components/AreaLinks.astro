---
import { cities } from '../data/site';
import Icon from './Icon.astro';
import '../styles/areas.css';
interface Props {
  current?: string;
}
const { current } = Astro.props;
---

<section class="neighborhood-section" aria-label="Our office and service areas">
  <div class="container">
    <header class="neighborhood-heading">
      <p class="eyebrow">Your neighborhood. Your insurance people.</p>
      <h2>
        One Downey office.
        <br />
        <em>A whole community.</em>
      </h2>
      <p>
        Insurance help for Southeast Los Angeles families and businesses. Come in with your
        questions, or work with our team by phone, text, and online.
      </p>
    </header>
    <div class="neighborhood-scene">
      <svg
        class="neighborhood-art"
        viewBox="0 0 1200 330"
        fill="none"
        aria-hidden="true"
        focusable="false"
      >
        <path
          d="M0 186 115 143 214 169 343 117 464 154 600 105 714 140 847 113 960 156 1111 113 1200 143V330H0Z"
          fill="#e1e2d5"
        />
        <path
          d="M0 227 160 198 331 224 502 191 689 207 858 190 1060 218 1200 194V330H0Z"
          fill="#d3dac9"
        />
        <path
          d="M-30 313C133 290 203 268 361 268H840C1000 268 1080 292 1230 316"
          stroke="#f6f1e7"
          stroke-width="43"
        />
        <path
          d="M-30 313C133 290 203 268 361 268H840C1000 268 1080 292 1230 316"
          stroke="#bcbbaa"
          stroke-width="1.5"
          stroke-dasharray="8 11"
        />
        <path
          d="M190 234C280 190 386 183 481 207M717 202C819 177 922 190 1016 236"
          stroke="#8a957c"
          stroke-width="1.5"
          stroke-dasharray="4 7"
        />
        <g stroke="#334e50" stroke-width="2" stroke-linejoin="round">
          <path d="M86 230V167L161 110 239 167V230Z" fill="#efe8d8" />
          <path d="m69 173 92-73 95 73" stroke="#142b44" stroke-width="9" />
          <path d="M150 230V180H181V230" fill="#748576" />
          <path d="M105 171H132V201H105ZM199 171H225V201H199Z" fill="#bdc9c4" />
          <path d="M118 171V201M212 171V201M105 186H132M199 186H225" />
          <path d="M119 129V100H139V114" fill="#b39b76" />
          <path d="M75 234H252" stroke="#8a957c" stroke-width="6" />
          <path d="M297 243V190L346 148 395 190V243Z" fill="#ebe4d1" />
          <path d="m285 195 61-54 61 54" stroke="#7b896e" stroke-width="7" />
          <path d="M333 243V207H358V243" fill="#9b8055" />
          <path d="M308 195H325V214H308ZM368 195H385V214H368Z" fill="#bdc9c4" />
          <path d="M895 240V155H1099V240Z" fill="#eee6d4" />
          <path d="M883 156H1110V138H883Z" fill="#b9a686" />
          <path d="M912 180H982V232H912ZM1024 180H1084V232H1024Z" fill="#b5c2b6" />
          <path d="M993 191H1014V240H993Z" fill="#748576" />
          <path d="M907 170H1089L1100 191H896Z" fill="#748576" />
          <path
            d="M923 170 917 191M947 170 944 191M972 170V191M997 170V191M1022 170 1025 191M1047 170 1053 191M1072 170 1080 191"
            stroke="#eee6d4"
            stroke-width="9"
          />
          <path d="M798 243V196H865V243Z" fill="#b6a482" />
          <path d="m789 196 42-35 43 35" fill="#748576" />
          <path d="M811 213H834V231H811ZM844 209H857V243" fill="#eee6d4" />
        </g>
        <g stroke="#142b44" stroke-width="2" stroke-linejoin="round">
          <path d="M475 248V148H724V248Z" fill="#f5f0e5" />
          <path d="M460 149H739V130H460Z" fill="#142b44" />
          <path d="M489 176H554V233H489ZM646 176H709V233H646Z" fill="#aebfb6" />
          <path d="M567 169H632V248H567Z" fill="#142b44" />
          <path d="M576 178H623V225H576Z" fill="#c8d3c8" />
          <path d="M618 227V234" stroke="#cba660" stroke-width="3" />
          <path d="M489 206H554M522 176V233M646 206H709M677 176V233" />
          <path d="M474 163H725" stroke="#b28d4c" stroke-width="4" />
          <path d="M454 252H744" stroke="#8a957c" stroke-width="7" />
        </g>
        <g fill="#6d8068">
          <ellipse cx="53" cy="208" rx="23" ry="36" />
          <ellipse cx="267" cy="214" rx="18" ry="29" />
          <ellipse cx="763" cy="215" rx="20" ry="30" />
          <ellipse cx="1138" cy="208" rx="26" ry="40" />
        </g>
        <g stroke="#647459" stroke-width="4">
          <path d="M53 206V244M267 215V245M763 216V245M1138 207V250" />
        </g>
        <g stroke="#967d51" stroke-width="5">
          <path d="M405 204 414 64M862 204 851 64" />
        </g>
        <g fill="#61715c">
          <path d="M414 67c-16-39-50-36-61-17 27-5 42 2 61 17Zm0 0c13-41 49-42 63-24-29-2-43 10-63 24Zm0 0c-38-15-55 7-52 29 13-23 27-28 52-29Zm0 0c35-19 54-1 58 21-19-19-34-25-58-21Z" />
          <path d="M851 67c-16-39-50-36-61-17 27-5 42 2 61 17Zm0 0c13-41 49-42 63-24-29-2-43 10-63 24Zm0 0c-38-15-55 7-52 29 13-23 27-28 52-29Zm0 0c35-19 54-1 58 21-19-19-34-25-58-21Z" />
        </g>
        <path
          d="M600 34c-18 0-30 13-30 29 0 22 30 46 30 46s30-24 30-46c0-16-12-29-30-29Z"
          fill="#142b44"
        />
        <circle cx="600" cy="63" r="10" fill="#c5a15d" />
        <g fill="#142b44">
          <path d="M325 293h59l-10-15h-32Z" />
          <path d="M316 292h73v15h-73Z" />
          <circle cx="332" cy="308" r="7" />
          <circle cx="375" cy="308" r="7" />
        </g>
        <path d="m343 280-6 10h35l-6-10Z" fill="#bec8bf" />
      </svg>
      <div class="neighborhood-office-label">
        <Icon name="pin" size={19} />
        <span>
          Our office
          <br />
          <strong>Downey, California</strong>
        </span>
      </div>
    </div>
    <div class="neighborhood-directory">
      <div class="neighborhood-directory-top">
        <p class="eyebrow">Explore coverage near you</p>
        <span>Serving these communities from Downey</span>
      </div>
      <nav class="neighborhood-city-links" aria-label="Explore our service areas">
        {cities
          .filter((c) => c.slug !== current)
          .map((c) => (
            <a href={`/insurance/${c.slug}`}>
              <span>{c.name}</span>
              <Icon size={18} />
            </a>
          ))}
      </nav>
      <div class="neighborhood-visit">
        <div>
          <strong>Come by. We’ll talk it through.</strong>
          <address>9907-B Paramount Blvd, Downey, CA 90240</address>
          <p>Monday–Friday · 10:00 AM–5:30 PM</p>
        </div>
        <a href="/locations" class="button neighborhood-visit-button">
          Hours & directions <Icon />
        </a>
      </div>
    </div>
  </div>
</section>
