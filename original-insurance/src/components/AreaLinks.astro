---
import { cities, contact } from '../data/site';
import Icon from './Icon.astro';
import ServiceAreaMap from './ServiceAreaMap.astro';
interface Props {
  current?: string;
}
const { current } = Astro.props;
---

<section id="service-areas" class="section local-area" aria-label="Our office and service areas">
  <div class="container local-area-grid">
    <div class="local-area-copy">
      <p class="eyebrow">Downey & Southeast Los Angeles</p>
      <h2>
        One Downey office.
        <br />A wider community.
      </h2>
      <p>
        Visit our team on Paramount Boulevard, or get help by phone, text, and online from the
        surrounding communities we serve.
      </p>
      <a href="/locations" class="text-link">
        Office hours & directions <Icon />
      </a>
      <nav class="area-city-links" aria-label="Explore a service area">
        {cities.map((city) => (
          <a
            href={`/insurance/${city.slug}`}
            aria-current={current === city.slug ? 'page' : undefined}
          >
            {city.name}
            <Icon size={14} />
          </a>
        ))}
      </nav>
      <p class="local-area-language">
        Prefer Spanish?{' '}
        <a href="/es" lang="es" data-spanish>
          Hable con nuestro equipo.
        </a>
      </p>
      <a href={contact.phoneHref} class="text-link">
        Call our Downey office <Icon name="phone" size={17} />
      </a>
    </div>
    <ServiceAreaMap current={current} />
  </div>
</section>
