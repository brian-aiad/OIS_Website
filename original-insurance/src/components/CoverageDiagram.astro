---
interface Props {
  type?: string;
}
const { type = 'auto' } = Astro.props;
const home = type === 'home';
const documents = type === 'sr22' || type === 'no-license';
const labels = home
  ? ['Dwelling', 'Personal property', 'Personal liability']
  : type === 'commercial'
    ? ['Your vehicles', 'Your operations', 'Your team']
    : type === 'sr22'
      ? ['Policy', 'Insurer filing', 'DMV review']
      : type === 'no-license'
        ? ['Vehicle owner', 'Actual drivers', 'Carrier eligibility']
        : ['Liability', 'Collision & comprehensive', 'Limits & deductibles'];
const explanations: Record<string, string[]> = {
  auto: [
    'Liability helps pay for injury or damage you cause to other people, subject to the policy’s limits and terms.',
    'Collision and comprehensive address different kinds of damage to your own car. Deductibles and exclusions apply.',
    'Compare limits and deductibles alongside the price. Ask what is included and what is excluded.',
  ],
  home: [
    'Dwelling coverage addresses covered damage to the home’s structure. Review the rebuilding limit and policy exclusions.',
    'Personal property coverage helps with covered losses to belongings. Special limits may apply to certain valuables.',
    'Personal liability addresses covered claims involving injury or damage to others. Ask about limits and exclusions.',
  ],
  commercial: [
    'List the vehicles, who owns them, and their actual use. A personal policy may not fit the work being done.',
    'Describe deliveries, job sites, operating radius, and any contracts. These details help the agency explore suitable options.',
    'Provide the drivers who use the vehicles. Eligibility and coverage depend on the insurer and policy terms.',
  ],
  sr22: [
    'An SR-22 is evidence of financial responsibility, not a separate kind of auto policy. Start with the insurance appropriate to your situation.',
    'If required, the insurer files the certificate. Ask whether the insurer offers the filing before purchasing.',
    'The DMV determines your reinstatement requirements. A filing by itself does not restore driving privileges.',
  ],
  'no-license': [
    'Explain who owns the car and why coverage is needed. Some situations involve an owner who does not drive.',
    'Identify every actual driver and their license status accurately. Never list someone as a driver only to obtain a quote.',
    'Options depend on the insurer’s rules. Insurance does not authorize anyone to drive without a valid license.',
  ],
};
const details = explanations[type] || explanations.auto;
---

<div class="coverage-diagram" aria-label={labels.join(', ')}>
  <div class="diagram-top">
    <span class="eyebrow">The coverage picture</span>
    <span>O / I</span>
  </div>
  <svg viewBox="0 0 480 240" aria-hidden="true" fill="none">
    <path d="M30 206H450M50 222H430" stroke="currentColor" opacity=".25" />
    {home ? (
      <g stroke="currentColor" stroke-width="2">
        <path d="m80 115 160-85 160 85M100 105v100h280V105M204 205v-80h70v80M126 125h50v40h-50zM300 125h50v40h-50zM150 74V40h25v20" />
        <path d="M240 30v-9m-7 9h14" />
        <path d="M126 145h50m-25-20v40m149-20h50m-25-20v40" opacity=".4" />
      </g>
    ) : type === 'no-license' ? (
      <g stroke="currentColor" stroke-width="2">
        <rect x="30" y="70" width="110" height="95" rx="4" />
        <path d="m46 117 15-20h43l19 20v21H45v-21Zm4 0h65" />
        <circle cx="61" cy="138" r="7" />
        <circle cx="108" cy="138" r="7" />
        <path pathLength="1" d="M145 118h35m-7-6 7 6-7 6M299 118h35m-7-6 7 6-7 6" />
        <rect x="187" y="70" width="105" height="95" rx="4" />
        <circle cx="239" cy="98" r="13" />
        <path d="M214 146v-12c0-25 50-25 50 0v12" />
        <path d="M343 165V70h62l25 25v70Zm62-95v25h25m-67 20h47m-47 17h35m-35 17h42" />
      </g>
    ) : documents ? (
      <g stroke="currentColor" stroke-width="2">
        <path d="M110 190V38h138l35 35v117H110ZM248 38v35h35M140 90h85m-85 22h112m-112 22h75M95 60H80v145h170v-15" />
        <path d="m153 161 10 10 21-23" />
        <rect x="282" y="109" width="113" height="72" rx="5" fill="var(--sage)" />
        <circle cx="309" cy="132" r="9" />
        <path d="M294 165v-10c0-13 30-13 30 0v10m16-34h40m-40 16h28" />
      </g>
    ) : type === 'commercial' ? (
      <g stroke="currentColor" stroke-width="2">
        <path d="M67 166V55h235v111m0-74h63l44 54v35h-28m-48 0H153m-48 0H67v-15m245-64v43h76l-34-43h-42ZM89 80h191m-191 19h191m-191 19h191" />
        <circle cx="129" cy="180" r="25" />
        <circle cx="357" cy="180" r="25" />
        <circle cx="129" cy="180" r="10" />
        <circle cx="357" cy="180" r="10" />
      </g>
    ) : (
      <g stroke="currentColor" stroke-width="2">
        <path d="m77 127 45-56h185l59 56 45 12v48h-41m-53 0H159m-52 0H65v-44l12-16Zm0 0h289M134 82l-30 37h101V82Zm87 0v37h112l-39-37ZM80 148h30m260 0h26" />
        <circle cx="133" cy="183" r="26" />
        <circle cx="344" cy="183" r="26" />
        <circle cx="133" cy="183" r="11" />
        <circle cx="344" cy="183" r="11" />
      </g>
    )}
  </svg>
  <div class="diagram-explanations">
    {labels.map((label, i) => (
      <details>
        <summary>
          <span>0{i + 1}</span>
          {label}
          <b aria-hidden="true">+</b>
        </summary>
        <p>{details[i]}</p>
      </details>
    ))}
  </div>
  <p class="diagram-instruction">Choose a topic to see how it fits.</p>
</div>
