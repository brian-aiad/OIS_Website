---
import Photo from './Photo.astro';
import Icon from './Icon.astro';
import { coverage } from '../data/site';
import { quoteHref, quoteLabel } from '../intake/context';
const details = [
  ['Liability limits', 'Your vehicle', 'Drivers & use'],
  ['Your property', 'Your belongings', 'Personal liability'],
  ['Work vehicles', 'Business use', 'Your drivers'],
];
---

<div class="coverage-explorer" data-coverage-explorer>
  <div class="explorer-tabs" aria-label="Explore insurance coverage" hidden>
    {coverage.slice(0, 3).map((item, i) => (
      <button
        type="button"
        id={`coverage-tab-${item.key}`}
        data-coverage-tab={i}
        aria-controls={`coverage-panel-${item.key}`}
      >
        <Icon name={i === 0 ? 'car' : i === 1 ? 'home' : 'file'} size={24} />
        <span>
          {item.name}
          <small>
            {i === 0
              ? 'For everyday driving'
              : i === 1
                ? 'For the place you live'
                : 'For vehicles at work'}
          </small>
        </span>
        <Icon size={18} />
      </button>
    ))}
    <p>Different policies protect different things. Start with what you need to insure.</p>
  </div>
  <div class="explorer-panels">
    {coverage.slice(0, 3).map((item, i) => (
      <article id={`coverage-panel-${item.key}`} data-coverage-panel={i}>
        <a
          class="explorer-image"
          href={item.path}
          aria-label={`Explore ${item.name.toLowerCase()}`}
        >
          <Photo src={item.image} alt={item.alt} sizes="(max-width: 760px) 92vw, 58vw" />
        </a>
        <div class="explorer-detail">
          <div>
            <h3>{item.name}</h3>
            <p>{item.description}</p>
            <ul aria-label="Topics to compare">
              {details[i].map((detail) => (
                <li>{detail}</li>
              ))}
            </ul>
          </div>
          <div class="explorer-actions">
            <a href={quoteHref(item.path)} data-quote class="button button-ink">
              {quoteLabel(item.path)} <Icon />
            </a>
            <a href={item.path} class="text-link">
              Compare coverage types <Icon />
            </a>
          </div>
        </div>
      </article>
    ))}
  </div>
</div>
