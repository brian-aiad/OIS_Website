---
import Icon from './Icon.astro';
---

<div
  class="broker-connection"
  data-reveal
  aria-label="You tell Original Insurance what you need. Our team explores available insurance markets with you."
>
  <div class="connection-needs">
    <span class="connection-stage">01 · Your needs</span>
    <strong>Start with what you need to insure.</strong>
    <span>Your vehicle, property, or business.</span>
  </div>
  <svg viewBox="0 0 100 24" fill="none" aria-hidden="true">
    <path pathLength="1" d="M0 12H96m-7-7 7 7-7 7" />
  </svg>
  <div class="connection-agency">
    <span class="connection-stage">02 · Your independent agency</span>
    <strong>Original Insurance</strong>
    <span>We explain the available options. You choose.</span>
  </div>
  <svg viewBox="0 0 100 80" fill="none" aria-hidden="true">
    <path
      pathLength="1"
      d="M0 40H30Q45 40 45 25V14Q45 8 55 8H96M30 40H96M30 40Q45 40 45 55V66Q45 72 55 72H96"
    />
  </svg>
  <div class="connection-markets">
    <span class="connection-stage">03 · Available markets</span>
    <span>
      <Icon name="car" size={19} /> Auto
    </span>
    <span>
      <Icon name="home" size={19} /> Property
    </span>
    <span>
      <Icon name="file" size={19} /> Business
    </span>
  </div>
</div>
