---
import Photo from './Photo.astro';
import Icon from './Icon.astro';
import { contact } from '../data/site';
import { quoteHref, quoteLabel } from '../intake/context';
const quoteUrl = quoteHref(Astro.url.pathname);
interface Props {
  label: string;
  title: string;
  text: string;
  image?: string;
  alt?: string;
  imageCaption?: string;
  variant?: string;
  quote?: boolean;
}
const {
  label,
  title,
  text,
  image,
  alt = '',
  imageCaption = 'Downey, California',
  variant = '',
  quote = true,
} = Astro.props;
---

<section
  class:list={[
    'page-hero',
    variant,
    image || Astro.slots.has('visual') ? 'has-image' : 'text-hero',
  ]}
>
  <div class="container">
    <nav class="breadcrumbs" aria-label="Breadcrumb">
      <a href="/">Home</a>
      <span aria-hidden="true">/</span>
      <span aria-current="page">{label}</span>
    </nav>
    <div class="page-hero-grid">
      <div class="page-hero-copy">
        <h1>{title}</h1>
        <p class="lede">{text}</p>
        {quote && (
          <div class="actions">
            <a href={quoteUrl} data-quote class="button button-ink">
              {quoteLabel(Astro.url.pathname)} <Icon />
            </a>
            <a href={contact.phoneHref} class="text-link">
              Call our team <Icon name="phone" size={17} />
            </a>
          </div>
        )}
        <slot />
      </div>
      {!image && Astro.slots.has('visual') && (
        <div class="page-hero-graphic">
          <slot name="visual" />
        </div>
      )}
      {image && (
        <figure class="page-hero-image">
          <Photo src={image} alt={alt} eager />
          <figcaption>
            <span>Original Insurance Services</span>
            <span>{imageCaption}</span>
          </figcaption>
        </figure>
      )}
    </div>
  </div>
</section>
