---
import LineMotif from './LineMotif.astro';
interface Props {
  kind?: 'home' | 'business' | 'renewal' | 'policy';
  size?: 'small' | 'medium';
}
const { kind = 'renewal', size = 'medium' } = Astro.props;
---

<span
  class:list={['painted-accent', `painted-accent-${size}`]}
  aria-hidden="true"
  data-motion="art"
>
  <LineMotif kind={kind === 'home' ? 'home' : kind === 'business' ? 'business' : 'document'} />
</span>

<style>
  .painted-accent {
    display: block;
    width: 190px;
    max-width: 100%;
    flex-shrink: 0;
    pointer-events: none;
  }
  .painted-accent :global(svg) {
    display: block;
    width: 100%;
    height: auto;
    object-fit: contain;
  }
  .painted-accent-small {
    width: 110px;
  }
  @media (max-width: 760px) {
    .painted-accent {
      width: 130px;
    }
    .painted-accent-small {
      width: 90px;
    }
  }
</style>
