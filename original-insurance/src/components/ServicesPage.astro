---
import PageHero from './PageHero.astro';
import Photo from './Photo.astro';
import Icon from './Icon.astro';
import LineMotif from './LineMotif.astro';
import { quoteHref, quoteLabel } from '../intake/context';
import CTA from './CTA.astro';
import LineAccent from './LineAccent.astro';
import { coverage, additional } from '../data/site';
const audiences = [
  'For daily drivers, family vehicles, and your next car.',
  'For homeowners and renters, with options for the place and belongings you protect.',
  'For the vehicles you use for work and the business behind them.',
];
---

<PageHero
  label="Coverage & services"
  title="Insurance for your car, home, and business."
  text="Start with what you need to protect. Our Downey team will explain the coverage, compare available carriers, and help you understand your choices."
  quote={false}
/>
<section class="coverage-catalog">
  <div class="container">
    <nav class="catalog-jump" aria-label="Choose a coverage category">
      {coverage.map((c) => (
        <a href={`#${c.key}`}>
          {c.name}
          <Icon size={15} />
        </a>
      ))}
      <a href="#more-insurance">
        More insurance <Icon size={15} />
      </a>
      <a href="#office-services">
        Office services <Icon size={15} />
      </a>
    </nav>
    {coverage.slice(0, 3).map((c, i) => (
      <article class="catalog-row" id={c.key} data-reveal>
        <a class="catalog-image" href={c.path} aria-label={`Explore ${c.name}`}>
          <Photo src={c.image} alt={c.alt} sizes="(max-width: 760px) 92vw, 38vw" />
        </a>
        <div class="catalog-copy">
          <p class="eyebrow">{i === 2 ? 'Business insurance' : 'Personal insurance'}</p>
          <h2>{c.name}</h2>
          <p class="catalog-audience">{audiences[i]}</p>
          <p>{c.description}</p>
          <div class="actions">
            <a href={quoteHref(c.path)} data-quote class="button button-ink">
              {quoteLabel(c.path)} <Icon />
            </a>
            <a href={c.path} class="text-link">
              Coverage guide <Icon />
            </a>
          </div>
        </div>
      </article>
    ))}
  </div>
</section>
<section class="catalog-guidance section">
  <div class="container catalog-guidance-layout">
    <div class="catalog-guidance-intro">
      <p class="eyebrow">Help with the next step</p>
      <h2>SR-22 or a license question?</h2>
      <p>
        Tell us about your situation. We can explain what insurers may need and which requirements
        to confirm with the DMV.
      </p>
      <LineMotif kind="document" />
    </div>
    <div class="catalog-guidance-links">
      {coverage.slice(3).map((c) => (
        <article id={c.key}>
          <h3>{c.name}</h3>
          <p>{c.description}</p>
          <a class="text-link" href={c.path}>
            Read the guide <Icon />
          </a>
        </article>
      ))}
      <p class="catalog-guidance-note">
        An SR-22 is a filing made by an insurer. Insurance does not give an unlicensed person
        permission to drive.
      </p>
    </div>
  </div>
</section>
<section class="section catalog-additional" id="more-insurance">
  <div class="container">
    <div class="catalog-extra-heading">
      <div>
        <p class="eyebrow">More insurance options</p>
        <h2>Beyond auto and home.</h2>
      </div>
      <LineAccent kind="renewal" />
    </div>
    <div class="additional-services">
      {additional.slice(0, 4).map((s) => (
        <article id={s.id}>
          <div>
            <h3>{s.name}</h3>
            <p>{s.text}</p>
            {s.id === 'recreational' ? (
              <div class="actions">
                <a href="/quote?type=rv" data-quote>
                  Get an RV quote ↗
                </a>
                <a href="/quote?type=boat" data-quote>
                  Get a boat quote ↗
                </a>
              </div>
            ) : (
              <a href={`/quote?type=${s.id === 'business' ? 'other' : s.id}`} data-quote>
                {s.id === 'business' ? 'Ask about business coverage' : `Get a ${s.id} quote`} ↗
              </a>
            )}
          </div>
        </article>
      ))}
    </div>
  </div>
</section>
<section class="section catalog-office" id="office-services">
  <div class="container">
    <h2>Services at our Downey office.</h2>
    <p>
      Not insurance products—practical help from our local office. Contact us to confirm what to
      bring.
    </p>
    <div class="additional-services">
      {additional.slice(4).map((s) => (
        <article id={s.id}>
          <div>
            <h3>{s.name}</h3>
            <p>{s.text}</p>
            <a href="/contact">Ask about {s.name.toLowerCase()} ↗</a>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<CTA />
<style>
  .catalog-extra-heading {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 28px;
    margin-bottom: 30px;
  }
  .catalog-extra-heading h2 {
    margin: 12px 0 0;
  }
  @media (max-width: 760px) {
    .catalog-extra-heading {
      gap: 12px;
    }
    .catalog-extra-heading :global(.painted-accent) {
      width: 95px;
    }
    .catalog-extra-heading h2 {
      font-size: 32px;
    }
  }
  @media (max-width: 380px) {
    .catalog-extra-heading {
      align-items: start;
    }
    .catalog-extra-heading :global(.painted-accent) {
      width: 75px;
    }
    .catalog-extra-heading h2 {
      font-size: 28px;
    }
  }
</style>
