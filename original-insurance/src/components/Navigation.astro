---
import { Image } from 'astro:assets';
import logo from '../assets/logo-badge.webp';
import Icon from './Icon.astro';
import { contact, coverage } from '../data/site';
import { quoteHref } from '../intake/context';
const spanish = Astro.url.pathname === '/es';
const quoteUrl = quoteHref(Astro.url.pathname, spanish ? 'es' : undefined);
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const links = spanish
  ? [
      ['/es#opciones', 'Coberturas'],
      ['/es#ayuda', 'Su póliza'],
      ['/es#oficina', 'Ubicación'],
      ['/', 'English'],
    ]
  : [
      ['/about', 'Our story'],
      ['/locations', 'Visit us'],
      ['/faq', 'Questions'],
      ['/contact', 'Policy help & contact'],
    ];
---

<a href="#main-content" class="skip-link">
  {spanish ? 'Ir al contenido' : 'Skip to content'}
</a>
<nav
  class="utility-bar"
  aria-label={spanish ? 'Información y idiomas' : 'Agency information and languages'}
  lang={spanish ? 'es' : 'en'}
>
  <div class="container">
    <span>
      {spanish ? 'Agencia independiente · Desde 1999' : 'Independent insurance · Established 1999'}
    </span>
    <span>
      English ·{' '}
      <a href={`/es?from=${encodeURIComponent(path)}`} lang="es" data-spanish>
        Español
      </a>{' '}
      · <bdi lang="ar">العربية</bdi> <span class="utility-separator">/</span>{' '}
      <a href={contact.phoneHref}>
        <bdi>{contact.phone}</bdi>
      </a>
    </span>
  </div>
</nav>
<header class="site-header" lang={spanish ? 'es' : 'en'}>
  <div class="container nav-inner">
    <a href="/" class="brand">
      <Image src={logo} width={48} height={48} densities={[1, 2, 3]} loading="eager" alt="" />
      <span>
        ORIGINAL <small>INSURANCE SERVICES</small>
      </span>
    </a>
    <nav class="desktop-nav" aria-label={spanish ? 'Navegación principal' : 'Main navigation'}>
      {!spanish && (
        <details class="coverage-menu">
          <summary
            class:list={[
              path === '/services' || coverage.some((c) => c.path === path) ? 'current' : '',
            ]}
          >
            Coverage <Icon name="plus" size={14} />
          </summary>
          <div class="coverage-dropdown">
            <p class="eyebrow">Insurance coverage</p>
            {coverage.map((c) => (
              <a href={c.path} aria-current={path === c.path ? 'page' : undefined}>
                <span>{c.name}</span>
                <Icon size={17} />
              </a>
            ))}
            <a href="/insurance-markets">
              Insurance companies & markets <Icon size={17} />
            </a>
            <a href="/services" class="all-coverage">
              Explore all services <Icon size={17} />
            </a>
          </div>
        </details>
      )}
      {links.map(([url, label]) => (
        <a href={url} aria-current={path === url ? 'page' : undefined}>
          {label}
        </a>
      ))}
    </nav>
    <div class="nav-actions">
      <a href={quoteUrl} data-quote class="button button-ink nav-quote">
        {spanish ? 'Cotización' : 'Get a quote'} <Icon size={17} />
      </a>
      <button
        class="menu-toggle"
        aria-label={spanish ? 'Abrir navegación' : 'Open navigation'}
        aria-controls="mobile-nav"
        aria-expanded="false"
      >
        <Icon name="menu" />
      </button>
    </div>
  </div>
</header>
<dialog
  id="mobile-nav"
  class="mobile-menu"
  lang={spanish ? 'es' : 'en'}
  aria-labelledby="mobile-title"
>
  <div class="mobile-menu-top">
    <span id="mobile-title" class="eyebrow">
      Original Insurance
    </span>
    <button
      data-close-menu
      class="icon-button"
      aria-label={spanish ? 'Cerrar navegación' : 'Close navigation'}
    >
      <Icon name="close" />
    </button>
  </div>
  <nav aria-label="Mobile navigation">
    <a href="/">
      {spanish ? 'Sitio en inglés' : 'Home'} <Icon />
    </a>
    {!spanish && (
      <details>
        <summary>
          Explore coverage <Icon name="plus" />
        </summary>
        <div>
          {coverage.map((c) => (
            <a href={c.path} aria-current={path === c.path ? 'page' : undefined}>
              {c.name}
            </a>
          ))}
          <a href="/services">All services</a>
          <a href="/insurance-markets">Insurance companies & markets</a>
        </div>
      </details>
    )}
    {links.map(([url, label]) => (
      <a href={url} aria-current={path === url ? 'page' : undefined}>
        {label}
        <Icon />
      </a>
    ))}
  </nav>
  <div class="mobile-menu-bottom">
    <a href={`/es?from=${encodeURIComponent(path)}`} lang="es" data-spanish>
      Atención en español <Icon />
    </a>
    <a href={contact.phoneHref}>{contact.phone}</a>
    <p>
      {spanish
        ? 'Lun–vie · 10:00 a. m.–5:30 p. m., hora del Pacífico'
        : 'Mon–Fri · 10:00 AM–5:30 PM Pacific'}
    </p>
    <a href={quoteUrl} data-quote class="button button-gold">
      {spanish ? 'Cotización en inglés' : 'Start your quote'} <Icon />
    </a>
  </div>
</dialog>
