---
import { contact, coverage } from '../data/site';
import Icon from './Icon.astro';
const spanish = Astro.url.pathname === '/es';
const companyLinks = [
  { href: '/insurance-markets', label: 'Insurance companies & markets' },
  { href: '/es', label: 'Atención en español' },
  { href: '/about', label: 'Our story' },
  { href: '/locations', label: 'Our Downey office' },
  { href: '/faq', label: 'Common questions' },
  { href: '/contact', label: 'Contact & support' },
  { href: 'https://g.page/original-insurance', label: 'Google reviews ↗' },
  { href: 'https://www.facebook.com/157258154314691/', label: 'Facebook ↗' },
  { href: 'https://www.linkedin.com/company/original-insurance-services/', label: 'LinkedIn ↗' },
];
---

{spanish ? (
  <footer class="site-footer spanish-footer" lang="es">
    <div class="container">
      <div class="footer-opening">
        <p>¿Tiene preguntas? Hable con nuestro equipo.</p>
        <a href={contact.phoneHref} class="footer-phone">
          {contact.phone}
          <Icon name="diagonal" size={32} />
        </a>
      </div>
      <div class="spanish-footer-grid">
        <div>
          <p class="footer-brand">Original Insurance Services</p>
          <address>{contact.address}</address>
          <p>Lunes a viernes · 10:00 a. m.–5:30 p. m., hora del Pacífico.</p>
          <a href={contact.textHref}>Enviar un mensaje</a>
        </div>
        <nav aria-label="Ayuda y contacto">
          <a href="/es#opciones">Opciones de seguro</a>
          <a href="/es#ayuda">Ayuda con su póliza</a>
          <a href={contact.maps} target="_blank" rel="noreferrer">
            Cómo llegar a la oficina
          </a>
          <a href="/quote?lang=es" data-quote>
            Cotización (formulario en inglés)
          </a>
        </nav>
      </div>
      <div class="footer-legal">
        <span>© {new Date().getFullYear()} Original Insurance Services</span>
        <div>
          <a href="/privacy">Privacidad (en inglés)</a>
          <a href="/accessibility">Accesibilidad (en inglés)</a>
          <a href="/" lang="en">
            English website
          </a>
        </div>
      </div>
    </div>
  </footer>
) : (
  <>
    <footer class="site-footer" lang="en">
      <div class="container">
        <div class="footer-opening">
          <p class="eyebrow">Coverage questions? Call our Downey team.</p>
          <a href={contact.phoneHref} class="footer-phone">
            {contact.phone}
            <Icon name="diagonal" size={54} />
          </a>
        </div>
        <div class="footer-columns">
          <div class="footer-office">
            <p class="footer-brand">Original Insurance Services</p>
            <p class="footer-intro">
              Independent in Downey.
              <br />
              Here for you since 1999.
            </p>
            <a href={contact.maps} target="_blank" rel="noreferrer">
              9907-B Paramount Blvd
              <br />
              Downey, CA 90240 <span aria-hidden="true">↗</span>
            </a>
            <a href={contact.phoneHref}>{contact.phone}</a>
            <a href={contact.emailHref}>{contact.email}</a>
            <p>
              Mon–Fri · 10 AM–5:30 PM
              <br />
              English · Spanish · Arabic
            </p>
          </div>
          <nav aria-label="Footer coverage">
            <h2>Coverage</h2>
            {coverage.map((c) => (
              <a href={c.path}>{c.name}</a>
            ))}
            <a href="/services">All services</a>
          </nav>
          <nav aria-label="Footer company">
            <h2>Get to know us</h2>
            {companyLinks.map((link) => (
              <a
                href={link.href}
                lang={link.href === '/es' ? 'es' : undefined}
                data-spanish={link.href === '/es' ? true : undefined}
                target={link.href.startsWith('https:') ? '_blank' : undefined}
                rel={link.href.startsWith('https:') ? 'noreferrer' : undefined}
              >
                {link.label}
              </a>
            ))}
          </nav>
        </div>
        <nav class="footer-areas" aria-label="Service areas">
          <span>At home in Southeast LA</span>
          <div>
            <a href="/locations#service-areas">All service areas</a>
            <a href="/insurance/downey">Insurance in Downey</a>
          </div>
        </nav>
        <nav class="footer-mobile-links" aria-label="Footer navigation">
          <details>
            <summary>
              Coverage <span aria-hidden="true">+</span>
            </summary>
            <div>
              {coverage.map((c) => (
                <a href={c.path}>{c.name}</a>
              ))}
              <a href="/services">All services</a>
            </div>
          </details>
          <details>
            <summary>
              Get to know us <span aria-hidden="true">+</span>
            </summary>
            <div>
              {companyLinks.map((link) => (
                <a
                  href={link.href}
                  lang={link.href === '/es' ? 'es' : undefined}
                  data-spanish={link.href === '/es' ? true : undefined}
                  target={link.href.startsWith('https:') ? '_blank' : undefined}
                  rel={link.href.startsWith('https:') ? 'noreferrer' : undefined}
                >
                  {link.label}
                </a>
              ))}
            </div>
          </details>
          <details>
            <summary>
              Service areas <span aria-hidden="true">+</span>
            </summary>
            <div>
              <a href="/locations#service-areas">All service areas</a>
              <a href="/insurance/downey">Insurance in Downey</a>
            </div>
          </details>
        </nav>
        <div class="footer-legal">
          <span>© {new Date().getFullYear()} Original Insurance Services</span>
          <div>
            <a href="/privacy">Privacy</a>
            <a href="/accessibility">Accessibility</a>
            <a href="https://cdicloud.insurance.ca.gov/cal/" target="_blank" rel="noreferrer">
              Verify a license ↗
            </a>
            <a href="#top">Back to top ↑</a>
          </div>
        </div>
      </div>
    </footer>
  </>
)}

<style>
  .footer-mobile-links {
    display: none;
  }
  @media (max-width: 760px) {
    .site-footer {
      padding: 25px 0 18px;
    }
    .footer-opening {
      padding-bottom: 16px;
      gap: 0;
    }
    .footer-opening .eyebrow {
      display: none;
    }
    .footer-phone {
      font-size: 40px;
      justify-content: space-between;
      width: 100%;
      gap: 20px;
      white-space: nowrap;
    }
    .footer-phone svg {
      width: 28px;
      height: 28px;
    }
    .footer-columns {
      display: block;
      padding: 18px 0 16px;
    }
    .footer-columns > nav,
    .footer-areas {
      display: none;
    }
    .footer-office {
      display: grid;
      grid-template-columns: 1fr;
      gap: 3px;
    }
    .footer-office .footer-brand {
      margin: 0 0 6px;
      font-size: 16px;
      grid-column: auto;
    }
    .footer-office .footer-intro {
      display: none;
    }
    .footer-office > a {
      font-size: 13px;
      max-width: 100%;
      padding: 5px 0;
      line-height: 1.55;
    }
    .footer-office > a[href^='mailto:'] {
      overflow-wrap: normal;
      white-space: nowrap;
    }
    .footer-office p:not(.footer-brand) {
      margin: 5px 0 0;
      font-size: 13px;
      line-height: 1.65;
    }
    .footer-mobile-links {
      display: block;
      border-top: 1px solid #ffffff25;
    }
    .footer-mobile-links details {
      border-bottom: 1px solid #ffffff25;
    }
    .footer-mobile-links summary {
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 20px;
      min-height: 46px;
      list-style: none;
      font-size: 13px;
      font-weight: 500;
      color: var(--paper);
      cursor: pointer;
    }
    .footer-mobile-links summary::-webkit-details-marker {
      display: none;
    }
    .footer-mobile-links summary > span {
      font-size: 20px;
      font-weight: 400;
      color: var(--gold-light);
      transition: transform 0.2s;
    }
    .footer-mobile-links details[open] summary > span {
      transform: rotate(45deg);
    }
    .footer-mobile-links details > div {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 0 18px;
      padding: 0 0 12px;
    }
    .footer-mobile-links details a {
      display: flex;
      align-items: center;
      min-height: 42px;
      font-size: 12px;
      line-height: 1.5;
      padding: 6px 0;
    }
    .footer-legal {
      margin-top: 15px;
      gap: 7px;
      font-size: 12px;
    }
    .footer-legal > div {
      gap: 6px 17px;
    }
    .footer-legal a {
      min-height: 30px;
      display: inline-flex;
      align-items: center;
      padding: 3px 0;
    }
  }
</style>
