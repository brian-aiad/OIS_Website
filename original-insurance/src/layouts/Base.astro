---
import Analytics from '../components/Analytics.astro';
import MobileActions from '../components/MobileActions.astro';
import Navigation from '../components/Navigation.astro';
import Footer from '../components/Footer.astro';
import EditorialTrust from '../components/EditorialTrust.astro';
import { intentRoutes } from '../intake/context';
import { origin, contact, cities, coverage } from '../data/site';
import '@fontsource-variable/dm-sans';
import displayFont from '@fontsource-variable/dm-sans/files/dm-sans-latin-wght-normal.woff2?url';
import '../styles/index.css';
interface Props {
  lang?: 'en' | 'es';
  title: string;
  description: string;
  path?: string;
  label?: string;
  editorial?: boolean;
  noindex?: boolean;
  image?: string;
}
const {
  lang = 'en',
  title,
  description,
  path = Astro.url.pathname,
  label = '',
  editorial = false,
  noindex = false,
  image,
} = Astro.props;
const canonical = origin + (path === '/' ? '/' : path.replace(/\/$/, ''));
const intent = intentRoutes[path];
const socialKey = lang === 'es' ? 'es' : intent?.need || intent?.type || 'original-insurance';
const imageUrl = origin + (image || `/images/social/${socialKey}.jpg`);
const agency = ![
  '/faq',
  '/about',
  '/contact',
  '/services',
  '/privacy',
  '/accessibility',
  '/404',
  '/quote',
  '/es',
  '/insurance-markets',
].includes(path);
const schemas: Record<string, unknown>[] = [
  {
    '@context': 'https://schema.org',
    '@type': path === '/about' ? 'AboutPage' : path === '/contact' ? 'ContactPage' : 'WebPage',
    '@id': canonical + '#webpage',
    url: canonical,
    name: title,
    description,
    inLanguage: lang,
    ...(path === '/'
      ? {
          thumbnailUrl: imageUrl,
          primaryImageOfPage: {
            '@type': 'ImageObject',
            url: origin + '/images/southern-california-insurance-v3.webp',
          },
        }
      : {}),
  },
];
if (agency && !noindex)
  schemas.push({
    '@context': 'https://schema.org',
    '@type': 'InsuranceAgency',
    '@id': origin + '/#agency',
    name: 'Original Insurance Services',
    url: origin + '/',
    telephone: '+1-310-538-8666',
    email: contact.email,
    foundingDate: '1999',
    image: [origin + '/images/ois-storefront-real.jpg'],
    logo: origin + '/logo.png',
    address: {
      '@type': 'PostalAddress',
      streetAddress: '9907-B Paramount Blvd',
      addressLocality: 'Downey',
      addressRegion: 'CA',
      postalCode: '90240',
      addressCountry: 'US',
    },
    areaServed: cities.map((c) => ({ '@type': 'City', name: c.name + ', CA' })),
    openingHoursSpecification: [
      {
        '@type': 'OpeningHoursSpecification',
        dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday'],
        opens: '10:00',
        closes: '17:30',
      },
    ],
    contactPoint: {
      '@type': 'ContactPoint',
      telephone: '+1-310-538-8666',
      contactType: 'customer service',
      availableLanguage: ['English', 'Spanish', 'Arabic'],
    },
    sameAs: [
      'https://www.facebook.com/157258154314691/',
      'https://www.linkedin.com/company/original-insurance-services/',
      'https://g.page/original-insurance',
    ],
  });
const service = coverage.find((c) => c.path === path);
if (service)
  schemas.push({
    '@context': 'https://schema.org',
    '@type': 'Service',
    '@id': canonical + '#service',
    name: service.name,
    description: service.description,
    url: canonical,
    provider: { '@id': origin + '/#agency' },
    areaServed: { '@type': 'State', name: 'California' },
  });
if (path === '/')
  schemas.push({
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    '@id': origin + '/#website',
    name: 'Original Insurance Services',
    alternateName: 'Original Insurance',
    url: origin + '/',
  });
if (path !== '/' && !noindex)
  schemas.push({
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: origin + '/' },
      ...(path.startsWith('/insurance/')
        ? [
            {
              '@type': 'ListItem',
              position: 2,
              name: 'Service areas',
              item: origin + '/locations',
            },
            { '@type': 'ListItem', position: 3, name: label, item: canonical },
          ]
        : [{ '@type': 'ListItem', position: 2, name: label || title, item: canonical }]),
    ],
  });
---

<!doctype html>
<html lang={lang} id="top">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <link rel="preload" href={displayFont} as="font" type="font/woff2" crossorigin />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta
      name="robots"
      content={
        noindex
          ? 'noindex, follow'
          : 'index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1'
      }
    />
    <meta name="theme-color" content="#142b44" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Original Insurance Services" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:type" content="image/jpeg" />
    <meta
      property="og:image:alt"
      content="Insurance coverage and personal service from Original Insurance in Downey"
    />
    <meta property="og:locale" content={lang === 'es' ? 'es_US' : 'en_US'} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />
    <link rel="icon" href="/favicon.png" sizes="32x32" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    {schemas.map((schema) => (
      <script
        type="application/ld+json"
        set:html={JSON.stringify(schema).replaceAll('<', '\\u003c')}
      />
    ))}
    <Analytics />
  </head>
  <body>
    <Navigation />
    <main id="main-content" tabindex="-1">
      <slot />
    </main>
    {editorial && <EditorialTrust />}
    <Footer />
    {!noindex && <MobileActions lang={lang} />}

    <script src="../scripts/site.ts"></script>
  </body>
</html>
