---
import { Image } from 'astro:assets';
import logo from '../assets/logo-badge.webp';
import Intake from '../layouts/Intake.astro';
import { agency } from '../intake/agency';
---

<Intake title="Let’s find your coverage" path="/quote">
  <header class="intake-header">
    <a class="brand" href="/" aria-label={agency.name + ' home'}>
      <Image src={logo} alt="" width={46} height={46} />
      <span>
        {agency.name}
        <small>SERVICES · EST. {agency.established}</small>
      </span>
    </a>
    <a class="header-help" href={agency.phoneHref}>
      <span>Questions? Call our team.</span>
      <strong>{agency.phone}</strong>
    </a>
  </header>
  <main id="main" class="quote-layout">
    <aside class="quote-aside">
      <div>
        <p class="eyebrow">REQUEST A QUOTE</p>
        <h1>
          Let’s compare <br />
          your coverage.
        </h1>
        <p class="aside-intro">
          Tell us what you’d like to protect. We’ll help you explore the options.
        </p>
      </div>
      <nav aria-label="Quote progress" id="quote-progress"></nav>
      <div class="aside-bottom">
        <span class="small-seal" aria-hidden="true">
          {agency.initials}
        </span>
        <div>
          <strong>Independent insurance since 1999.</strong>
          <p>
            {agency.location}
            <br />
            {agency.languages}
          </p>
        </div>
      </div>
    </aside>
    <div class="quote-workspace">
      <div id="quote-root" aria-busy="true">
        <div class="loading-card" role="status">
          <span class="loading-dot"></span>Getting your form ready…
        </div>
      </div>
      <noscript>
        <div class="form-card">
          Please enable JavaScript to complete this guided form, or call{' '}
          <a href={agency.phoneHref}>{agency.phone}</a> for help with a quote.
        </div>
      </noscript>
      <footer class="quote-footer">
        <span>Your information goes to {agency.name}.</span>
        <a href="/privacy" target="_blank" rel="noopener">
          Privacy notice ↗
        </a>
      </footer>
    </div>
  </main>
  <script>
    import '../intake/quote';
  </script>
</Intake>
