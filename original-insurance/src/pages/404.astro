---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
---

<Base
  title="Page not found | Original Insurance"
  description="Find insurance coverage or contact the Original Insurance team in Downey."
  path="/404"
  noindex
>
  <section class="not-found">
    <span class="error-number" aria-hidden="true">
      404
    </span>
    <h1>Page not found.</h1>
    <p>The link may have changed. Explore our coverage or contact our team for help.</p>
    <div class="actions">
      <a href="/" class="text-link">
        Home <Icon />
      </a>
      <a href="/quote" class="text-link">
        Get a quote <Icon />
      </a>
      <a href="/services" class="button button-ink">
        Explore coverage <Icon />
      </a>
      <a href="/contact" class="button button-outline">
        Contact our team
      </a>
    </div>
  </section>
</Base>
