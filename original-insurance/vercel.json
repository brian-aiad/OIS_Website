{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "installCommand": "npm install",
  "redirects": [
    {
      "source": "/index.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/SITEMAP.XML",
      "destination": "/sitemap.xml",
      "permanent": true
    },
    {
      "source": "/services/",
      "destination": "/services",
      "permanent": true
    },
    {
      "source": "/locations/",
      "destination": "/locations",
      "permanent": true
    },
    {
      "source": "/about/",
      "destination": "/about",
      "permanent": true
    },
    {
      "source": "/contact/",
      "destination": "/contact",
      "permanent": true
    },
    {
      "source": "/faq/",
      "destination": "/faq",
      "permanent": true
    },
    {
      "source": "/auto-insurance-downey-ca/",
      "destination": "/auto-insurance-downey-ca",
      "permanent": true
    },
    {
      "source": "/sr22-insurance-downey/",
      "destination": "/sr22-insurance-downey",
      "permanent": true
    },
    {
      "source": "/no-license-auto-insurance-downey/",
      "destination": "/no-license-auto-insurance-downey",
      "permanent": true
    },
    {
      "source": "/commercial-auto-insurance-downey/",
      "destination": "/commercial-auto-insurance-downey",
      "permanent": true
    },
    {
      "source": "/home-insurance-downey-ca/",
      "destination": "/home-insurance-downey-ca",
      "permanent": true
    },
    {
      "source": "/insurance/downey/",
      "destination": "/insurance/downey",
      "permanent": true
    },
    {
      "source": "/insurance/norwalk/",
      "destination": "/insurance/norwalk",
      "permanent": true
    },
    {
      "source": "/insurance/bellflower/",
      "destination": "/insurance/bellflower",
      "permanent": true
    },
    {
      "source": "/insurance/lynwood/",
      "destination": "/insurance/lynwood",
      "permanent": true
    },
    {
      "source": "/insurance/cerritos/",
      "destination": "/insurance/cerritos",
      "permanent": true
    },
    {
      "source": "/insurance/whittier/",
      "destination": "/insurance/whittier",
      "permanent": true
    },
    {
      "source": "/insurance/lakewood/",
      "destination": "/insurance/lakewood",
      "permanent": true
    },
    {
      "source": "/insurance/paramount/",
      "destination": "/insurance/paramount",
      "permanent": true
    },
    {
      "source": "/insurance/south-gate/",
      "destination": "/insurance/south-gate",
      "permanent": true
    },
    {
      "source": "/insurance/pico-rivera/",
      "destination": "/insurance/pico-rivera",
      "permanent": true
    },
    {
      "source": "/insurance/montebello/",
      "destination": "/insurance/montebello",
      "permanent": true
    },
    {
      "source": "/insurance/commerce/",
      "destination": "/insurance/commerce",
      "permanent": true
    }
  ],
  "rewrites": [
    { "source": "/cdn-cgi/l/email-protection", "destination": "/api/gone" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "has": [{ "type": "query", "key": "q" }],
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow" }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/images/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=86400, stale-while-revalidate=604800" }
      ]
    },
    {
      "source": "/",
      "headers": [
        { "key": "Link", "value": "</images/ois-hero-storefront-logo-v4.webp>; rel=preload; as=image; type=image/webp; fetchpriority=high" }
      ]
    },
    {
      "source": "/sitemap.xml",
      "headers": [
        { "key": "Content-Type", "value": "application/xml; charset=utf-8" },
        { "key": "Cache-Control", "value": "public, max-age=3600" }
      ]
    },
    {
      "source": "/robots.txt",
      "headers": [
        { "key": "Content-Type", "value": "text/plain; charset=utf-8" },
        { "key": "Cache-Control", "value": "public, max-age=3600" }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Strict-Transport-Security", "value": "max-age=63072000; includeSubDomains; preload" },
        { "key": "X-DNS-Prefetch-Control", "value": "on" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), payment=(), usb=(), bluetooth=(), serial=(), geolocation=(self)" },
        { "key": "Content-Security-Policy", "value": "default-src 'self'; script-src 'self' 'unsafe-inline' https://www.googletagmanager.com https://www.google-analytics.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https:; connect-src 'self' https://api.web3forms.com https://www.google-analytics.com https://analytics.google.com https://stats.g.doubleclick.net https://vitals.vercel-insights.com; frame-src https://www.google.com https://maps.google.com https://quotzal.com; object-src 'none'; base-uri 'self'; form-action 'self' https://api.web3forms.com;" }
      ]
    }
  ]
}
